#!/bin/sh /etc/rc.common
# mrdark worker supervisor

START=95
STOP=10
USE_PROCD=1
PROG=/usr/libexec/mrdark/worker.sh

start_service() {
	procd_open_instance worker
	procd_set_param command /bin/sh "$PROG"
	procd_set_param stdout 1
	procd_set_param stderr 1
	# threshold timeout retry: never restart-loop a crashing worker
	procd_set_param respawn 3600 5 3
	procd_set_param limits core="0 0"
	procd_close_instance
}

stop_service() {
	# worker handles TERM itself (cleanup), but make sure nothing is left
	/usr/libexec/mrdark/cleanup.sh >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger mrdark
}
